{
  "hosting": {
    "site": "farad",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/ai/command",
        "function": "fleetAiCommand"
      },
      {
        "source": "/api/ai/vehicle-audit",
        "function": "vehicleAudit"
      },
      {
        "source": "/api/payment/create",
        "function": "createFlutterwavePayment"
      },
      {
        "source": "/api/payment/callback",
        "function": "flutterwaveCallback"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|woff|woff2|otf|ttf|eot)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
